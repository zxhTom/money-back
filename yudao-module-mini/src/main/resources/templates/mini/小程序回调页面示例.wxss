/* pages/callback/callback.wxss */
/* 小程序回调页面样式 */

.container {
  width: 100%;
  height: 100vh;
  position: relative;
}

/* 加载提示样式 */
.loading-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 999;
}

.loading-text {
  font-size: 16px;
  color: #666;
  margin-top: 10px;
}

/* 错误提示样式 */
.error-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 999;
  width: 80%;
}

.error-icon {
  font-size: 60px;
  margin-bottom: 20px;
}

.error-text {
  font-size: 16px;
  color: #666;
  margin-bottom: 30px;
}

.retry-button,
.back-button {
  width: 120px;
  height: 40px;
  line-height: 40px;
  margin: 10px;
  border-radius: 20px;
  font-size: 14px;
}

.retry-button {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.back-button {
  background: #f5f5f5;
  color: #333;
}

/* webview 样式 */
web-view {
  width: 100%;
  height: 100vh;
}

